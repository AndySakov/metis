{
  "description": "text.redact: what each kind of detail is found by, and what is deliberately left alone. `kinds` defaults to all of them.",
  "cases": [
    {
      "name": "an email and an international phone number",
      "text": "Call Amina on +254 712 345 678 or amina@example.com",
      "expect": { "text": "Call Amina on [phone] or [email]", "found": { "email": 1, "card": 0, "phone": 1, "ip": 0 } }
    },
    {
      "name": "a local number written with a leading zero, in brackets or not",
      "text": "Ring 0712345678, or the office on (020) 444-5566.",
      "expect": { "text": "Ring [phone], or the office on [phone].", "found": { "email": 0, "card": 0, "phone": 2, "ip": 0 } }
    },
    {
      "name": "a card number passes the Luhn check; a sixteen-digit order number does not",
      "text": "Paid with 4111 1111 1111 1111, order 1234567812345678.",
      "expect": { "text": "Paid with [card], order 1234567812345678.", "found": { "email": 0, "card": 1, "phone": 0, "ip": 0 } }
    },
    {
      "name": "amounts, years, dates and versions are not phone numbers",
      "text": "Ksh 1250000 in 2026, due 2026-10-24, on v1.2.3 and 10.5%",
      "expect": { "text": "Ksh 1250000 in 2026, due 2026-10-24, on v1.2.3 and 10.5%", "found": { "email": 0, "card": 0, "phone": 0, "ip": 0 } }
    },
    {
      "name": "an IPv4 address, but not a version string or an out-of-range quad",
      "text": "Server 192.168.1.20 runs 1.2.3.4.5 and rejected 300.1.1.1",
      "expect": { "text": "Server [ip] runs 1.2.3.4.5 and rejected 300.1.1.1", "found": { "email": 0, "card": 0, "phone": 0, "ip": 1 } }
    },
    {
      "name": "the digits in an email address are the email's, not a phone's",
      "text": "Write to 0712345678@example.com",
      "expect": { "text": "Write to [email]", "found": { "email": 1, "card": 0, "phone": 0, "ip": 0 } }
    },
    {
      "name": "only the kinds asked for",
      "text": "amina@example.com, 0712345678",
      "kinds": ["phone"],
      "expect": { "text": "amina@example.com, [phone]", "found": { "email": 0, "card": 0, "phone": 1, "ip": 0 } }
    },
    {
      "name": "names are not found: that limit is the contract",
      "text": "Amina Wanjiru lives on Riverside Drive",
      "expect": { "text": "Amina Wanjiru lives on Riverside Drive", "found": { "email": 0, "card": 0, "phone": 0, "ip": 0 } }
    }
  ]
}
