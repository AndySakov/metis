{
  "name": "text-redact-patterns",
  "version": "0.1.0",
  "capability": "text.redact@0.1",
  "mcp": {
    "server": "redact.tools",
    "tool": "redact",
    "transport": "stdio"
  },
  "idempotent": true,
  "isolation": "process",
  "inputSchema": {
    "$ref": "../capabilities/text.redact@0.1.input.schema.json"
  },
  "outputSchema": {
    "$ref": "../capabilities/text.redact@0.1.output.schema.json"
  },
  "authScopes": [],
  "tests": [
    {
      "name": "minimal",
      "input": {
        "text": "mail me at a@example.com"
      },
      "expect": {
        "type": "object",
        "required": [
          "text",
          "found"
        ]
      }
    }
  ]
}
