  "cases": [
    {
      "name": "a red row is an open slot to fill, not a booking",
      "checkIn": "2026-08-10",
      "checkOut": "2026-08-12",
      "expect": {
        "verdict": "OPEN"
      }
    },
    {
      "name": "nothing in the sheet on these nights",
      "checkIn": "2026-08-03",
      "checkOut": "2026-08-05",
      "expect": {
        "verdict": "FREE"
      }
    },
    {
      "name": "an amber hot lead holds, but is still sellable",
      "checkIn": "2026-08-16",
      "checkOut": "2026-08-17",
      "expect": {
        "verdict": "CONTESTED"
      }
    },
    {
      "name": "a green booking blocks, and the next window is offered",
      "checkIn": "2026-08-21",
      "checkOut": "2026-08-23",
      "expect": {
        "verdict": "BOOKED",
        "nextWindow": {
          "checkIn": "2026-08-25",
          "checkOut": "2026-08-27"
        }
      }
    },
    {
      "name": "check-out day can be let again",
      "checkIn": "2026-08-25",
      "checkOut": "2026-08-27",
      "expect": {
        "verdict": "FREE"
      }
    },
    {
      "name": "a stay ending the morning after the last tab is covered",
      "checkIn": "2026-08-30",
      "checkOut": "2026-09-01",
      "expect": {
        "verdict": "FREE"
      }
    },
    {
      "name": "past the last month tab is not free, it is unknown",
      "checkIn": "2026-09-02",
      "checkOut": "2026-09-04",
      "expect": {
        "verdict": "NO DATA"
      }
    },
    {
      "name": "a day-first tab, read by its night count",
      "checkIn": "2026-05-18",
      "checkOut": "2026-05-19",
      "expect": {
        "verdict": "BOOKED"
      }
    },
    {
      "name": "a month-first tab without leading zeros",
      "checkIn": "2026-06-05",
      "checkOut": "2026-06-06",
      "expect": {
        "verdict": "BOOKED"
      }
    },
    {
      "name": "a booking from the previous month's last day",
      "checkIn": "2026-07-31",
      "checkOut": "2026-08-01",
      "expect": {
        "verdict": "BOOKED"
      }
    }
  ]
