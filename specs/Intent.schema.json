{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.metis.dev/Intent.schema.json",
  "title": "Intent",
  "description": "A recorded request to METIS, after the server has assigned identity and time. `IntentDraft` is what a client submits; this is what gets persisted and referenced by a Plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ts", "actor", "goal", "autonomy"],
  "properties": {
    "id": { "$ref": "https://schema.metis.dev/common/Identifier.schema.json" },
    "ts": { "$ref": "https://schema.metis.dev/common/Timestamp.schema.json" },
    "actor": { "$ref": "https://schema.metis.dev/common/Actor.schema.json" },
    "goal": {
      "description": "What the user wants, in one line.",
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "description": {
      "description": "Optional elaboration. `goal` is mandatory precisely so this does not have to be.",
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "https://schema.metis.dev/common/TaggedValue.schema.json"
      },
      "default": []
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "https://schema.metis.dev/common/TaggedValue.schema.json"
      },
      "default": []
    },
    "autonomy": {
      "description": "Requested autonomy gear (ADR-002). Absent on a draft means S0 — advise only — because the fail-safe default is the one that cannot cause a side effect.",
      "type": "string",
      "enum": ["S0", "S1", "S2", "S3", "S4"]
    }
  },
  "examples": [
    {
      "id": "01890a5d-ac96-774b-bcce-b302099a8057",
      "ts": 1735872000,
      "actor": "user:andysakov",
      "goal": "Draft a PRD for a research summarizer",
      "inputs": [{ "name": "audience", "value": "solo developer", "tags": [] }],
      "constraints": [
        { "name": "max_pages", "value": 3, "tags": ["hard"] }
      ],
      "autonomy": "S1"
    }
  ]
}
