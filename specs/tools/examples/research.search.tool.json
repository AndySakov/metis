{
  "name": "research-search-basic",
  "version": "0.1.0",
  "capability": "research.search@0.1",
  "mcp": {
    "server": "metis.research",
    "tool": "search",
    "transport": "stdio"
  },
  "idempotent": true,
  "isolation": "process",
  "inputSchema": {
    "$ref": "../../capabilities/research.search@0.1.input.schema.json"
  },
  "outputSchema": {
    "$ref": "../../capabilities/research.search@0.1.output.schema.json"
  },
  "authScopes": [
    "public.web"
  ],
  "tests": [
    {
      "name": "minimal",
      "input": {
        "query": "retrieval-augmented generation",
        "limit": 1
      },
      "expect": {
        "type": "object",
        "required": [
          "results"
        ]
      }
    }
  ]
}
