{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.metis.dev/WorkItem.schema.json",
  "title": "WorkItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "$ref": "https://schema.metis.dev/common/Identifier.schema.json"
    },
    "projectId": {
      "$ref": "https://schema.metis.dev/common/Identifier.schema.json"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "doing",
        "done"
      ]
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "$ref": "https://schema.metis.dev/common/Identifier.schema.json"
      }
    },
    "produces": {
      "type": "array",
      "items": {
        "$ref": "https://schema.metis.dev/common/Identifier.schema.json"
      }
    },
    "owner": {
      "$ref": "https://schema.metis.dev/common/Actor.schema.json"
    }
  }
}
