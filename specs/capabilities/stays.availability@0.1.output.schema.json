{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.metis.dev/capabilities/stays.availability@0.1.output.schema.json",
  "title": "stays.availability@0.1 output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit",
    "checkIn",
    "checkOut",
    "verdict",
    "detail",
    "markdown"
  ],
  "properties": {
    "unit": {
      "type": "string"
    },
    "checkIn": {
      "type": "string",
      "format": "date"
    },
    "checkOut": {
      "type": "string",
      "format": "date"
    },
    "verdict": {
      "description": "OPEN: an unsold slot carried for projection, fill it. FREE: nothing booked. CONTESTED: overlaps a hot lead that has not converted. BOOKED: clashes with a confirmed booking. NO DATA: past the sheet's last month.",
      "type": "string",
      "enum": [
        "OPEN",
        "FREE",
        "CONTESTED",
        "BOOKED",
        "NO DATA"
      ]
    },
    "detail": {
      "type": "string"
    },
    "nextWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkIn",
        "checkOut"
      ],
      "properties": {
        "checkIn": {
          "type": "string",
          "format": "date"
        },
        "checkOut": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "markdown": {
      "type": "string"
    }
  }
}
