{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.metis.dev/Artifact.schema.json",
  "title": "Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "kind",
    "title",
    "uri",
    "checksum",
    "created_at",
    "created_by"
  ],
  "properties": {
    "id": { "type": "string" },
    "kind": { "type": "string" },
    "title": { "type": "string" },
    "uri": { "type": "string" },
    "checksum": { "type": "string" },
    "created_at": { "type": "integer" },
    "created_by": { "type": "string", "enum": ["user", "metis"] },
    "metadata": {},
    "provenance": {}
  },
  "examples": [
    {
      "id": "art_prd_001",
      "kind": "markdown",
      "title": "PRD: Research Summarizer",
      "uri": "s3://artifacts/prd/research-summarizer.md",
      "checksum": "sha256:deadbeef",
      "created_at": 1735872000,
      "created_by": "metis"
    }
  ]
}
