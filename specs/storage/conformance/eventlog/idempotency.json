{
  "name": "eventlog idempotency",
  "interface": "EventLogStore",
  "description": "Appending the same id twice is one event, and the first write wins. ADR-007 makes the event id the idempotency key; a replayed append during durable execution (ADR-016) must not duplicate the audit record or silently rewrite its timestamp.",
  "steps": [
    {
      "op": "append",
      "event": {
        "id": "01890a5d-c000-7000-8000-000000000001",
        "ts": 1700000000,
        "type": "TOOL_COMPLETED",
        "actor": "metis",
        "payload": {}
      }
    },
    {
      "op": "append",
      "event": {
        "id": "01890a5d-c000-7000-8000-000000000001",
        "ts": 1700000001,
        "type": "TOOL_COMPLETED",
        "actor": "metis",
        "payload": { "changed": true }
      }
    },
    {
      "op": "read",
      "query": {},
      "expect": {
        "count": 1,
        "uniqueIds": true,
        "firstWriteWins": { "id": "01890a5d-c000-7000-8000-000000000001", "ts": 1700000000 }
      }
    }
  ]
}
