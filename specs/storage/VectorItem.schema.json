{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.metis.dev/storage/VectorItem.schema.json",
  "title": "VectorItem",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "embedding"],
  "properties": {
    "id": { "type": "string" },
    "embedding": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 8
    },
    "meta": { "type": "object", "additionalProperties": true }
  }
}
